# ==============================================================================
# HypothesisAI Environment Configuration Template
# Copy this file to '.env' and populate your credentials.
# ==============================================================================

# 1. Google Gemini AI API Configuration (Required for AI Agents & Copilot)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# 2. Application Security & JWT Authentication
# Replace SECRET_KEY with a secure random string in production
SECRET_KEY="hypothesis-dev-secret-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Database Configuration
# Default uses local standalone SQLite database (zero external installation required)
DATABASE_URL="sqlite:///./data/hypothesis.db"
